<!-- Wrapper for mobile width -->
<div style="max-width:650px;margin:0 auto;font-family:system-ui,Arial,sans-serif;line-height:1.45;color:#222;font-size:16px;">
<style>
/* dark-mode support */
@media (prefers-color-scheme: dark){
  body{background:#111;color:#ddd;}
  a{color:#79B3FF;}
}
ul{margin:0 0 0 20px;padding:0;list-style-type:square;}
</style>

<hr>
<h2>📅 Daily Digest – YYYY-MM-DD</h2>

<hr style="margin:24px 0">

<!-- ↓↓↓ Table of Contents auto-generated ↓↓↓ -->
<ul id="toc">
  <!-- For each newsletter in digestItems -->
  {#each digestItems}
  <li><a href="#{this.anchorId}" aria-label="Jump to {this.title} section">{this.emoji} {this.title}</a></li>
  {/each}
</ul>
<hr>

<!-- TL;DR Newsletters Section -->
<h2>🔖 TL;DR Newsletters</h2>
<ul>
  <!-- For each email with type "news-brief" -->
  {#each digestItems.filter(item => item.type === 'news-brief')}
  <li>🔗 <strong>{this.title}</strong> — {this.bodyText.split('\n')[0]}</li>
  {/each}
</ul>

<!-- Newsletter Sections -->
{#each digestItems.filter(item => item.type !== 'news-brief')}
<div style="background:#f6f6f8;border-radius:8px;padding:18px 18px 10px 18px;margin-bottom:18px;box-shadow:0 1px 6px #0001;">
  <a id="{this.anchorId}"></a>
  <h2>
    {this.emoji} {this.title}
  </h2>

  <p><em>By {this.author} — Published YYYY-MM-DD</em><br>
  <a href="{this.sourceUrl}" aria-label="Visit {this.title} newsletter">Visit Newsletter</a></p>

  <!-- First non-tracking image removed -->

  <p><strong>Links</strong></p>
  <!-- If 2 or fewer links, render as horizontal list; else as vertical ul -->
  {#if this.links.length <= 2}
  <ul style="display:flex;gap:12px;list-style:none;padding:0;margin:0 0 12px 0;">
    {#each this.links}
    <li><span style="font-size:90%;">🔗</span> <a href="{this.url}" aria-label="Link to {this.text}">{this.text}</a></li>
    {/each}
  </ul>
  {:else}
  <ul>
    {#each this.links}
    <li><span style="font-size:90%;">🔗</span> <a href="{this.url}" aria-label="Link to {this.text}">{this.text}</a></li>
    {/each}
  </ul>
  {/if}

  <p><strong>Summary</strong></p>
  <p>
    A concise two to three paragraph summary covering the main points and main message of the article or newsletter.
  </p>
  <p>
    <a href="{this.sourceUrl}" style="background:#e6f0fa;border-radius:4px;padding:5px 12px;text-decoration:none;font-weight:bold;color:#1767b3;" aria-label="Read more about {this.title}">Read more</a>
  </p>

  <!-- Dynamic block by type -->
  {#if this.type === 'listicle' || this.type === 'event-blast'}
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr>
        <th style="text-align:left;border-bottom:1px solid #ccc;">Date</th>
        <th style="text-align:left;border-bottom:1px solid #ccc;">Event</th>
        <th style="text-align:left;border-bottom:1px solid #ccc;">Location</th>
      </tr>
    </thead>
    <tbody>
      <!-- up to 10 events -->
      <tr><td>Sat Jun 21</td><td>Durham Bee Day</td><td>Durham Farmers Market</td></tr>
      …
    </tbody>
  </table>
  <p style="margin-top:8px;"><em>…and <strong>N more</strong> events ➡️ <a href="{this.sourceUrl}" aria-label="See full list of events for {this.title}">see full list</a></em></p>
  <p><a href="{this.icsMasterLink}" aria-label="Add all events from {this.title} to calendar">📅 Add all to calendar</a></p>
  {:else if this.type !== 'news-brief'}
  <ul>
    <li>Bullet 1</li>
    <li>Bullet 2</li>
    <li>Bullet 3</li>
    <li>Bullet 4 (optional)</li>
  </ul>

  <p><strong>Main Takeaway</strong><br>
  2–3 sentences on impact/trend.</p>
  {/if}

  <!-- reddit block if applicable -->
  {#if this.type === 'reddit'}
  <ul>
    <li>⬆️ {this.score} <a href="{this.link}" aria-label="Reddit link to {this.title}">{this.title}</a> — u/{this.author}</li>
    …
  </ul>
  {/if}

  <div style="text-align:right;font-size:90%;"><a href="#toc" aria-label="Back to Table of Contents">↑ Back to Top</a></div>
</div>
<hr style="margin:32px 0 24px 0;">

<!-- Repeat for each newsletter item -->
{/each}

<h3>🔍 Trending Now</h3>
<ul>
  <li>📈 [Keyword] ↑ (mentions +3 vs. yesterday)</li>
  <li>📉 [Keyword] ↓</li>
</ul>

<!-- SKIPPED_TOTAL: X promos, Y duplicates -->
<!-- PARSE_ERRORS: Z -->
<!--METRICS {"skipped":X,"duplicates":Y,"parseErrors":Z} -->
</div> <!-- close wrapper -->